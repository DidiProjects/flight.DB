# Host interface the published port binds to. Loopback by default: the database
# is reachable only from this machine. Use the Tailscale IP to expose it to the
# tailnet; never 0.0.0.0, which publishes it to the whole LAN.
PG_BIND_IP=127.0.0.1

PG_USER=admin
PG_PASSWORD=admin123
PG_DB=dev-flightDB

ADMIN_EMAIL=admin@flight.local
ADMIN_INITIAL_PASSWORD=changeme123
